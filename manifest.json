{
  "manifest_version": 3,
  "name": "Web Weaver Lightning",
  "version": "4.2.0",
  "description": "Privacy-first Visual AI extraction: multimodal analysis (images, audio), batch translation/summarization, accessibility alt-text, extraction templates, AI insights—100% on-device with Chrome Built-in AI + Cloud fallback",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "classic"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/config.js",
        "src/utils/chrome-ai.js",
        "src/classifier.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "prompts/*",
        "config/*",
        "src/*.js",
        "src/utils/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
